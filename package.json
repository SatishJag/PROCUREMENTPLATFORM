{
  "name": "procurementplatform",
  "version": "1.0.0",
  "description": "Web UI, HTTP RPC API, and sample data for the procurement platform",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "demo": "node sample/demo.ts",
    "api": "node server/index.ts",
    "start": "node server/index.ts",
    "build": "npm --prefix web install --include=dev --legacy-peer-deps && npm --prefix web run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@satishjag/procurement-core": "github:SatishJag/Procurement_core#da71f42"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.0"
  }
}
